# GROQ_API_KEY: Primary AI engine for JARVIS. Configured via Secrets in AI Studio.
# Groq provides high-throughput Llama 3.3, GPT-OSS 120B, and DeepSeek inference.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GEMINI_API_KEY: Fallback multimodal engine.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Google OAuth 2.0 Credentials for popup Google Sign-In
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SESSION_SECRET=""
